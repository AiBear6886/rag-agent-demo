# ============================================================
# RAG + Agent 管理系统 · 环境配置
# ============================================================

# ===== 应用配置 =====
APP_NAME=RAG Agent System
APP_ENV=dev                       # dev / prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ===== 大模型（阿里云 DashScope / 通义千问 Qwen）=====
DASHSCOPE_API_KEY=sk-e6c
LLM_MODEL=qwen-plus               # 对话模型：qwen-plus / qwen-turbo
EMBEDDING_MODEL=text-embedding-v1 # 向量模型

# ===== 向量数据库 Milvus =====
MILVUS_HOST=8.2
MILVUS_PORT=19530
MILVUS_URI=http://81:19530
MILVUS_COLLECTION=mult_agent_knowledge      # RAG 知识库
MILVUS_MEMORY_COLLECTION=mult_agent_memory  # 多轮记忆库
MILVUS_DIMENSION=1536                        # text-embedding-v1 向量维度

# ===== Redis =====
REDIS_URL=redis://:xx@xx
REDIS_DB=0

# ===== PostgreSQL =====
POSTGRES_DSN=postgresql://root:xx@xx:5432/mydb
POSTGRES_USER=root
POSTGRES_PASSWORD=xx
POSTGRES_HOST=xx
POSTGRES_PORT=5432
POSTGRES_DB=mydb

# ===== 博查 Web Search（Agent 工具）=====
BOCHA_API_KEY=sk12e910d
BOCHA_ENDPOINT=https://api.bocha.cn/v1/web-search

# ===== OCR 文档解析（百度 Paddle-VL Parser）  https://cloud.baidu.com/doc/OCR/s/3mi73at9o 教程文档获取token=====
OCR_ENABLED=true
OCR_ACCESS_TOKEN=24.20518
OCR_CLIENT_ID=
OCR_CLIENT_SECRET=
OCR_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
OCR_TASK_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task
OCR_QUERY_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task/query
OCR_POLL_INTERVAL_SEC=3
OCR_POLL_MAX_ATTEMPTS=20
OCR_PDF_MIN_PAGE_CHARS=40
OCR_PDF_EMPTY_PAGE_RATIO=0.5
OCR_PDF_LOW_TEXT_AVG_CHARS=120
OCR_DOCX_MIN_CHARS=120
OCR_TABLE_LIKE_LINE_THRESHOLD=3

# ===== RAG 业务参数（默认值，后台可覆盖）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5                 # 最终返回的 chunk 数
VECTOR_CANDIDATES=20              # 向量召回候选数
BM25_CANDIDATES=20                # 关键词召回候选数

# ===== Text2SQL =====
SQL_MAX_ROWS=100                  # 单次查询返回上限
SQL_READONLY=true                 # 只读模式（只允许 SELECT）
